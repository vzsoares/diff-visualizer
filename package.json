{
    "name": "diff-visualizer",
    "version": "1.5.2",
    "description": "Paste a unified diff — or compare two texts — and share it as a URL. No server, no signup.",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check --write .",
        "release": "release-it"
    },
    "release-it": {
        "git": {
            "push": true
        },
        "github": {
            "release": true,
            "releaseName": "Release ${version}"
        },
        "npm": {
            "publish": false
        }
    },
    "keywords": [
        "diff",
        "diff-viewer",
        "diff-sharer",
        "unified-diff",
        "share",
        "alpinejs",
        "vite",
        "tailwindcss"
    ],
    "author": "vzsoares",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/vzsoares/diff-visualizer.git"
    },
    "homepage": "https://vzsoares.github.io/diff-visualizer/",
    "bugs": {
        "url": "https://github.com/vzsoares/diff-visualizer/issues"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@playwright/test": "^1.60.0",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.3.0",
        "@types/alpinejs": "^3.13.11",
        "@types/diff": "^8.0.0",
        "alpinejs": "^3.15.12",
        "daisyui": "^5.5.20",
        "pinecone-router": "^7.5.1",
        "release-it": "^20.0.1",
        "tailwindcss": "^4.3.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.14",
        "vitest": "^4.1.7"
    },
    "dependencies": {
        "diff": "^9.0.0",
        "diff2html": "^3.4.56",
        "lz-string": "^1.5.0"
    }
}
